{
  "name": "aimparency",
  "version": "1.0.0",
  "description": "Local-first idea management system with a browser UI, background service, and agent tooling for .bowman projects.",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/wrapped-agents/*"
  ],
  "scripts": {
    "dev:embedder": "bash packages/embedder/start.sh",
    "dev:mobile:config": "tsx packages/mobile/scripts/generate-config.ts",
    "dev:full": "node scripts/run-local-stack.mjs dev --full",
    "dev": "node scripts/run-local-stack.mjs dev",
    "dev:delay": "node scripts/run-local-stack.mjs dev --delay",
    "host": "node scripts/run-local-stack.mjs start --host",
    "dev:host": "node scripts/run-local-stack.mjs dev --host",
    "start": "node scripts/run-local-stack.mjs start",
    "start:fast": "node scripts/run-local-stack.mjs start --no-build",
    "validate:local-runtime": "node scripts/validate-local-runtime.mjs",
    "test:hooks": "bash scripts/hooks/test.sh",
    "verify:migration": "tsx packages/shared/scripts/verify-bowman-migration.ts",
    "stop-sessions": "npm run stop-sessions -w wrapped-agents-broker",
    "list-sessions": "npm run list-sessions -w wrapped-agents-broker",
    "build:core": "npm run build -w backend -w wrapped-agents-broker -w loop-worker -w wrapped-agents-claude-session -w wrapped-agents-codex-session -w wrapped-agents-gemini-session -w wrapped-agents-agy-session -w wrapped-agents-grok-session -w frontend",
    "build:optional": "npm run build:core && npm run build -w mcp -w voice-bridge",
    "build": "npm run build:core",
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit:backend && npm run test:unit:frontend && npm run test:unit:shared && npm run test:unit:mcp",
    "test:unit:backend": "npm run test -w backend",
    "test:unit:frontend": "npm test -w frontend",
    "test:unit:shared": "npm run test -w shared",
    "test:unit:mcp": "npm run test -w mcp",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:e2e:ci": "npm run test:e2e:ci -w frontend",
    "test:watch": "npm run test:unit:frontend",
    "ncu-upgrade": "npx npm-check-updates -u --deep && npm install",
    "expose:mcp": "dotenv -e .env -- npm run expose -w mcp",
    "real-world": "dotenv -e .env -- npm run start -w real-world --",
    "check": "node scripts/check.mjs",
    "knip": "knip --no-progress"
  },
  "keywords": [
    "aimparency",
    "bowman",
    "local-first",
    "goal-management",
    "agent-tools"
  ],
  "author": "Aimparency contributors",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "knip": "^5.88.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimparency/v7.git"
  },
  "bugs": {
    "url": "https://github.com/aimparency/v7/issues"
  },
  "homepage": "https://github.com/aimparency/v7#readme"
}

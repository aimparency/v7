{
  "name": "aimparency",
  "version": "1.0.0",
  "description": "Local-first idea management system with a browser UI, background service, and agent tooling for .bowman projects.",
  "private": true,
  "scripts": {
    "dev:mobile:config": "tsx packages/mobile/scripts/generate-config.ts",
    "dev:full": "node scripts/run-local-stack.mjs dev --full",
    "dev": "node scripts/run-local-stack.mjs dev",
    "dev:delay": "node scripts/run-local-stack.mjs dev --delay",
    "host": "node scripts/run-local-stack.mjs start --host",
    "dev:host": "node scripts/run-local-stack.mjs dev --host",
    "start": "node scripts/run-local-stack.mjs start",
    "start:fast": "node scripts/run-local-stack.mjs start --no-build",
    "validate:local-runtime": "node scripts/validate-local-runtime.mjs",
    "test:hooks": "bash scripts/hooks/test.sh",
    "verify:migration": "tsx packages/shared/scripts/verify-bowman-migration.ts",
    "stop-sessions": "pnpm --filter wrapped-agents-broker stop-sessions",
    "list-sessions": "pnpm --filter wrapped-agents-broker list-sessions",
    "build:core": "pnpm --filter backend --filter wrapped-agents-broker --filter loop-worker --filter wrapped-agents-claude-session --filter wrapped-agents-codex-session --filter wrapped-agents-gemini-session --filter wrapped-agents-agy-session --filter wrapped-agents-grok-session --filter frontend build",
    "build:optional": "pnpm build:core && pnpm --filter mcp --filter voice-bridge build",
    "build": "pnpm build:core",
    "test": "pnpm test:all",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm test:unit:backend && pnpm test:unit:frontend && pnpm test:unit:shared && pnpm test:unit:mcp",
    "test:unit:backend": "pnpm --filter backend test",
    "test:unit:frontend": "pnpm --filter frontend test",
    "test:unit:shared": "pnpm --filter shared test",
    "test:unit:mcp": "pnpm --filter mcp test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "test:e2e:ci": "pnpm --filter frontend test:e2e:ci",
    "test:watch": "pnpm test:unit:frontend",
    "ncu-upgrade": "pnpm --recursive update --latest",
    "expose:mcp": "dotenv -e .env -- pnpm --filter mcp expose",
    "real-world": "dotenv -e .env -- pnpm --filter real-world start",
    "check": "node scripts/check.mjs",
    "knip": "knip --no-progress",
    "protocol:schemas": "tsx packages/shared/scripts/protocol-schemas.ts",
    "validate:bowman": "tsx packages/shared/scripts/validate-bowman.ts",
    "dev:mobile": "sh scripts/dev-mobile.sh"
  },
  "keywords": [
    "aimparency",
    "bowman",
    "local-first",
    "goal-management",
    "agent-tools"
  ],
  "author": "Aimparency contributors",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "knip": "^5.88.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimparency/v7.git"
  },
  "bugs": {
    "url": "https://github.com/aimparency/v7/issues"
  },
  "homepage": "https://github.com/aimparency/v7#readme",
  "packageManager": "pnpm@11.3.0"
}

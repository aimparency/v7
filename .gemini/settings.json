{
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "puppeteer-mcp-server"
      ]
    }
  },
  "hooks": {
    "post_invocation": [
      {
        "type": "command",
        "command": "./scripts/hooks/on-stop.sh",
        "statusMessage": "Exiting AGY / Antigravity...",
        "timeout": 10
      }
    ]
  }
}
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "meta/**",
    "**/fixtures/**",
    "**/env.d.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.{test,spec}.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "packages/loop-worker": {
      "entry": [
        "src/**/*.{test,spec}.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts"
      ],
      "ignoreDependencies": [
        "uuid",
        "@huggingface/transformers"
      ]
    },
    "packages/wrapped-agents/*": {
      "entry": [
        "src/**/*.{test,spec}.ts",
        "src/scripts/**/*.ts"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}

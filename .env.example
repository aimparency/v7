PORT_BACKEND_HTTP=3000
PORT_BACKEND_WS=3001
PORT_MCP=3005
PORT_FRONTEND=4000
PORT_BROKER_HTTP=5000
PORT_BROKER_WS=5001
PORT_BROKER_CLIENT=5005
PORT_VOICE_BRIDGE=6000
PORT_PROCESS_START=7000
AIMPARENCY_DIR_NAME=.bowman
# MCP_PORT=3005 # Optional: Port for MCP SSE server (defaults to 3005 if running expose script)
# NGROK_AUTHTOKEN=your_ngrok_token_here # Required for expose:mcp script
# TUNNEL_PROVIDER=ngrok # 'ngrok' or 'localtunnel'
# MCP_USERNAME=admin # Optional: Basic Auth for ngrok
# MCP_PASSWORD=secret # Optional: Basic Auth for ngrok
OPENROUTER_API_KEY=tbd
# Written by the first `pnpm start` (or `pnpm start --setup`):
# AIMPARENCY_PROJECT=/srv/commons-hub  # the repository `pnpm start` opens
# AIMPARENCY_HOSTED=false              # true: serve it to a group, with accounts
# PORT=4000                            # hosted: the one port (UI, /trpc, /mcp)
# BIND_HOST=127.0.0.1                  # hosted: the address to listen on

{
  "name": "mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for Aimparency - allows LLMs to interact with ideas and phases",
  "type": "module",
  "bin": {
    "aimparency-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/index.ts",
    "dev:sse": "tsx watch src/sse.ts",
    "expose": "tsx scripts/expose.ts",
    "test": "NODE_ENV=test tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "aimparency",
    "goals",
    "ideas"
  ],
  "author": "Aimparency contributors",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimparency/v7.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/aimparency/v7/issues"
  },
  "homepage": "https://github.com/aimparency/v7/tree/main/packages/mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@trpc/client": "^11.5.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "shared": "workspace:*",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@trpc/server": "^11.7.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.1",
    "@types/ws": "^8.18.1",
    "backend": "workspace:*",
    "fs-extra": "^11.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Typecheck only: dev runs from source (tsx), builds are tsdown bundles, and
    // consumers read backend's types from source (package.json types → src/index.ts).
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aimparency/v7/blob/main/protocol/schemas/phase.schema.json",
  "title": "Aimparency phase",
  "description": ".bowman/phases/<id>.json: one phase and the ideas committed to it. Data model version 6.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "from": {
      "type": "number"
    },
    "to": {
      "type": "number"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "childPhaseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "parent",
    "commitments",
    "name"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aimparency/v7/blob/main/protocol/schemas/idea.schema.json",
  "title": "Aimparency idea",
  "description": ".bowman/ideas/<id>.json and .bowman/archived-ideas/<id>.json: one idea and its outgoing links. Data model version 6.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "text": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "archived": {
      "default": false,
      "type": "boolean"
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportingConnections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ideaId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "relativePosition": {
            "default": [
              0,
              0
            ],
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "weight": {
            "default": 1,
            "type": "number"
          },
          "hypothesis": {
            "type": "string"
          },
          "reflection": {
            "type": "string"
          }
        },
        "required": [
          "ideaId"
        ],
        "additionalProperties": false
      }
    },
    "supportingRepos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repoId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "relativePosition": {
            "default": [
              0,
              0
            ],
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "weight": {
            "default": 1,
            "type": "number"
          },
          "hypothesis": {
            "type": "string"
          },
          "reflection": {
            "type": "string"
          }
        },
        "required": [
          "repoId"
        ],
        "additionalProperties": false
      }
    },
    "incoming": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "supportedIdeas": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "committedIn": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "date": {
          "type": "number"
        },
        "reviewedAt": {
          "type": "number"
        }
      },
      "required": [
        "state",
        "comment",
        "date"
      ],
      "additionalProperties": false
    },
    "intrinsicValue": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "valueRationale": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "selfWeight": {
      "default": 0,
      "type": "number"
    },
    "duration": {
      "default": 1,
      "type": "number",
      "minimum": 0
    },
    "costVariance": {
      "default": 0,
      "type": "number"
    },
    "valueVariance": {
      "default": 0,
      "type": "number"
    },
    "calculatedValue": {
      "type": "number"
    },
    "calculatedCost": {
      "type": "number"
    },
    "calculatedDoneCost": {
      "type": "number"
    },
    "calculatedPriority": {
      "type": "number"
    }
  },
  "required": [
    "id",
    "text",
    "supportedIdeas",
    "committedIn",
    "status"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aimparency/v7/blob/main/protocol/schemas/meta.schema.json",
  "title": "Aimparency project meta",
  "description": ".bowman/meta.json: project settings and the data model version. Data model version 6.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "repoId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "linkedRepos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repoId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "repoId",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "initialInstructions": {
      "type": "string"
    },
    "supervisorGuidancePrefix": {
      "type": "string"
    },
    "costUnit": {
      "type": "string"
    },
    "defaultCost": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "ongoing": {
            "type": "boolean"
          },
          "promptsReflection": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "dataModelVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "const": 6
    },
    "phaseCursors": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "phaseActiveLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rootPhaseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "spacing": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "memory": {
          "type": "number",
          "minimum": 0
        },
        "length": {
          "type": "number",
          "minimum": 0
        },
        "semantic": {
          "type": "number",
          "minimum": 0
        },
        "spread": {
          "type": "number",
          "minimum": 0
        },
        "outward": {
          "type": "number",
          "minimum": 0
        },
        "space": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "separation": {
          "type": "number",
          "minimum": 0
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "spacing",
        "memory",
        "length",
        "semantic"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "color",
    "dataModelVersion"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aimparency/v7/blob/main/protocol/schemas/meta.schema.json",
  "title": "Aimparency project meta",
  "description": ".bowman/meta.json: project settings and the data model version. Data model version 4.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "repoId": {
      "type": "string",
      "format": "uuid"
    },
    "linkedRepos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repoId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "repoId",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "initialInstructions": {
      "type": "string"
    },
    "supervisorGuidancePrefix": {
      "type": "string"
    },
    "costUnit": {
      "type": "string"
    },
    "defaultCost": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "ongoing": {
            "type": "boolean"
          },
          "promptsEvaluation": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "dataModelVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "const": 4
    },
    "phaseCursors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "phaseActiveLevel": {
      "type": "integer",
      "minimum": 0
    },
    "rootPhaseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": [
    "name",
    "color",
    "dataModelVersion"
  ],
  "additionalProperties": false
}
